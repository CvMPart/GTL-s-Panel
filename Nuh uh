local function GetTarget()

    local BestOption = nil
    local HighestHP = 0
    local IsBoss = false

    for _, v in pairs(workspace:GetChildren()) do
        local humanoid = v:FindFirstChildOfClass("Humanoid")

        if v:FindFirstChild("EnemyMain") and humanoid and humanoid.Health > 0 and v.PrimaryPart and Player.Character and Player.Character.PrimaryPart and (v.PrimaryPart.Position - Player.Character.PrimaryPart.Position).Magnitude < 100000 then
              local currentHP = humanoid.Health
            if _G.NoForceFieldEnemy and not v:FindFirstChildOfClass("ForceField") or not _G.NoForceFieldEnemy then
               
                if v:FindFirstChild("Boss") then
                    if not IsBoss or currentHP > HighestHP then
                        BestOption = v
                        HighestHP = currentHP
                        IsBoss = true
                    end
                elseif not IsBoss then
                    -- Only pick normal enemies if no boss found yet
                    if currentHP > HighestHP then
                        BestOption = v
                        HighestHP = currentHP
                    end
                end
               
            end
        end
    end

    return BestOption, IsBoss
end

