--// FUNCTION: Convert table -> lua string
local function TableToLua(tbl)
    local str = "{\n"
    
    for key, value in pairs(tbl) do
        if type(value) == "string" then
            str = str .. string.format('    %s = "%s",\n', key, value)
        else
            str = str .. string.format('    %s = %s,\n', key, tostring(value))
        end
    end
    
    str = str .. "}"
    return str
end

--// FUNCTION: Save settings
local function SaveSettings(settings)
    local data = "return " .. TableToLua(settings)
    writefile(FilePath, data)
end

--// FUNCTION: Load settings
local function LoadSettings()
    if not isfile(FilePath) then
        -- Create default file
        SaveSettings(DefaultSettings)
        return DefaultSettings
    end

    local success, result = pcall(function()
        return loadstring(readfile(FilePath))()
    end)

    if success and type(result) == "table" then
        return result
    else
        -- If file is broken → reset
        SaveSettings(DefaultSettings)
        return DefaultSettings
    end
end

